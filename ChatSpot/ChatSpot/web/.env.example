# Copy to ".env.local" (gitignored) and set your deployed ASP.NET base URL — no trailing slash.
#
# When unset: `npm run dev` uses Vite proxy. Proxy target defaults to http://localhost:5215
# (override with VITE_DEV_PROXY_TARGET). When set: browser talks to this host (no proxy).
#
# VITE_API_URL=https://your-api.example.com
#
# Dev-only: where Vite proxies /api and /chatHub when VITE_API_URL is empty (no trailing slash).
# VITE_DEV_PROXY_TARGET=http://localhost:5215
#
# Optional: only if SignalR is on a different origin than VITE_API_URL
# VITE_SIGNALR_URL=https://your-signalr-host.example.com
