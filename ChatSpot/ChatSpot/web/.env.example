# Copy to ".env.local" (gitignored) and set your deployed ASP.NET base URL — no trailing slash.
#
# When unset: `npm run dev` uses Vite proxy → http://localhost:5215 (local API).
# When set: browser talks to this host for /api and /chatHub (no proxy).
#
# VITE_API_URL=https://your-api.example.com
#
# Optional: only if SignalR is on a different origin than VITE_API_URL
# VITE_SIGNALR_URL=https://your-signalr-host.example.com
